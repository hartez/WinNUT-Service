{
	"Logging": {
		"LogLevel": {
			"Default": "Information",
			"Microsoft.Hosting.Lifetime": "Information",
			"Microsoft.AspNetCore": "Warning"
		}
	},
	
	"NUTClientConfig": {
		"Host": "localhost"
	},

	"MonitorConfig": {
		"PollingIntervalSeconds": 10,
		"UPSSerialNumber": "12345",
		"ShutdownDelaySeconds": 180,
		"ChargeThreshold": 50,
		"RemainingThresholdSeconds": 480,
		"ReconnectAttemptIntervalSeconds": 60
	},

	"AllowedHosts": "*",
	"Kestrel": {
		"EndpointDefaults": {
			"Protocols": "Http2"
		}
	}
}
